---
import Layout from '../layouts/Layout.astro';
import Carousel from './Carousel.astro';
---

<Layout class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 bg-black">
    <Carousel />
    <section>
      <div class="bg-black">
        <div class="min-h-40 bg-gray-600 rounded-t-full" />
      </div>
      <div class="bg-gradient-to-b bg-[#314158] from-gray-600 to-[#314158]">
        <h2 class="text-center text-4xl font-extrabold tracking-tight mb-8 md:flex md:justify-center gap-x-1">
          <p class="bg-gradient-to-r from-indigo-500 to-indigo-200 text-transparent bg-clip-text">成為</p>
          <p class="mx-3 text-white">MOPCON</p>
          <p class="bg-gradient-to-r from-indigo-500 to-indigo-200 text-transparent bg-clip-text">贊助夥伴</p>
        </h2>
        <div class="flex justify-center py-5">
          <div class="flex-col">
            <p class="w-fit rounded-r-full rounded-tl-full bg-gray-300 py-2 px-4 my-5 font-bold text-xl">加入MOPCON夥伴，最大的優勢是？</p>
            <img src="/sponsor/sponsor6.svg" class="rounded-3xl" alt="sponsor image 1" />
          </div>
        </div>
        <div class="flex justify-center py-5">
          <div class="flex-col">
            <p class="w-fit rounded-r-full rounded-tl-full bg-gray-300 py-2 px-4 my-5 font-bold text-xl">加入MOPCON夥伴，會接觸到何種與會者？</p>
            <img src="/sponsor/sponsor7.svg" class="rounded-3xl" alt="sponsor image 2" />
          </div>
        </div>
      </div>
    </section>
</Layout>
