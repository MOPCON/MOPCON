---

<Layout>
  <section class="agenda">
    <!-- Hero section with background -->
    <div class="agenda-hero">
      <!-- Background layer -->
      <div class="agenda-hero__bg">
        <Image
          src={agendaBg}
          alt="Agenda Background"
          class="agenda-hero__bg-image"
        />
      </div>

      <!-- Hero content layer -->
      <div class="agenda-hero__content">
        <h1 class="agenda__title font-mantou">精采議程</h1>

        <div class="agenda__seg">
          <SegmentedControl options={dates} value="day1" />
        </div>

        <div class="agenda__filters" id="agenda-filters">
          {
            topics.map((t) => (
              <FilterChip label={t} selected={true} client:load />
            ))
          }
        </div>
      </div>
    </div>

    <!-- Schedule grid (outside hero) -->
    <div class="agenda__days">
      {
        ["day1", "day2"].map((day) => (
          <div
            class="agenda__grid"
            data-day={day}
            class:list={{ hidden: day !== "day1" }}
          >
            {routine.map((slot) => {
              const slotSessions =
                (sessionsByDay[day] && sessionsByDay[day][slot.start]) || {};
              const isTalk = slot.type === "talk";
              return (
                <div class="agenda__row">
                  <div class="agenda__time">{slot.start}</div>
                  <div class="agenda__slot">
                    {isTalk ? (
                      <>
                        <div class="h-[1rem] flex">
                          <div class="agenda__divider" />
                        </div>
                        <div class="agenda__cards">
                          <button
                            class="agenda__cardbtn"
                            data-open-modal
                            data-topics={
                              slotSessions.R1
                                ? JSON.stringify(slotSessions.R1.topics)
                                : "[]"
                            }
                          >
                            {slotSessions.R1 && (
                              <SessionCard session={slotSessions.R1} />
                            )}
                          </button>
                          <button
                            class="agenda__cardbtn"
                            data-open-modal
                            data-topics={
                              slotSessions.R2
                                ? JSON.stringify(slotSessions.R2.topics)
                                : "[]"
                            }
                          >
                            {slotSessions.R2 && (
                              <SessionCard session={slotSessions.R2} />
                            )}
                          </button>
                        </div>
                      </>
                    ) : (
                      <>
                        <div class="h-[1rem] flex">
                          <div class="agenda__divider" />
                        </div>
                        <div class="agenda__event-simple">{slot.label}</div>
                      </>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        ))
      }
    </div>
  </section>

  <SessionModal open={false} client:load>
    <div slot="topic">
      <div class="modal__tags">
        {topics.slice(0, 3).map((t) => <span class="tag">{t}</span>)}
      </div>
      <p class="modal__text">
        在我們享受行動及 IoT
        設備帶給我們的便利時，隱藏的數位威脅是否悄悄伺機而動？本議程將帶你理解如何運用開源工具來監控和保護你的網路。
      </p>
    </div>
    <div slot="speaker">
      <div class="speaker__head">
        <img class="avatar" src="/2025/avatar-demo.webp" alt="speaker" />
        <div>
          <div class="name">曾厚荃</div>
          <div class="title">Gronext RD 研發工程師</div>
        </div>
      </div>
      <p class="modal__text">
        現職為研發工程師，專長於網路維運與資安探索，負責前端開發及資料流整合。
      </p>
    </div>
  </SessionModal>
</Layout>

<script>
  // Function to apply filters to session cards
  function applyFilters() {
    const filterButtons = document.querySelectorAll("#agenda-filters button");
    const selectedTopics: string[] = [];

    // Collect all selected topic filters
    filterButtons.forEach((btn) => {
      if (btn.classList.contains("is-selected")) {
        selectedTopics.push(btn.textContent?.trim() || "");
      }
    });

    // Get all session card buttons
    const sessionCards =
      document.querySelectorAll<HTMLElement>(".agenda__cardbtn");

    sessionCards.forEach((card) => {
      const topicsAttr = card.getAttribute("data-topics");
      if (!topicsAttr) return;

      try {
        const cardTopics = JSON.parse(topicsAttr) as string[];

        // If no filters selected, show all cards
        if (selectedTopics.length === 0) {
          card.classList.remove("hidden");
          return;
        }

        // Check if card has at least one matching topic
        const hasMatch = cardTopics.some((topic) =>
          selectedTopics.includes(topic),
        );

        if (hasMatch) {
          card.classList.remove("hidden");
        } else {
          card.classList.add("hidden");
        }
      } catch (e) {
        // If parsing fails, show the card
        card.classList.remove("hidden");
      }
    });
  }

  const filters = document.getElementById("agenda-filters")!;
  filters.addEventListener("click", (e) => {
    const target = (e.target as HTMLElement).closest("button");
    if (!target) return;
    target.classList.toggle("is-selected");
    // Apply filters after toggle
    applyFilters();
  });

  document.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest("[data-open-modal]");
    const modal = document.querySelector("dialog.modal") as HTMLDialogElement;
    if (btn && modal) modal.showModal();
  });

  // switch days via segmented control
  const seg = document.querySelector(".agenda__seg .segmented") as HTMLElement;
  if (seg) {
    seg.addEventListener("change", (e: any) => {
      const value = e.detail as string;
      document
        .querySelectorAll<HTMLElement>(".agenda__grid")
        .forEach((grid) => {
          if (grid.dataset.day === value) {
            grid.classList.remove("hidden");
          } else {
            grid.classList.add("hidden");
          }
        });
    });
  }

  // Apply initial filters on page load
  applyFilters();
</script>

<style>
  .agenda {
