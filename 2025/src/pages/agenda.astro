  /* Background layer */
  .agenda-hero__bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1;
    pointer-events: none;
  }

  .agenda-hero__bg-image {
    width: 100%;
    height: auto;
