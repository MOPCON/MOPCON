  }

  .agenda__title {
    color: #020618;
    font-size: 48px;
    text-align: center;
    margin-bottom: 16px;
  }
  .agenda__seg {
    display: flex;
    justify-content: center;
    margin-bottom: 16px;
  }
  .agenda__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    margin-bottom: 16px;
  }
  .agenda__grid {
    margin-top: 8px;
    display: grid;
    gap: 18px;
  }
  .agenda__row {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 18px;
    align-items: start;
  }
  .agenda__time {
    color: #a9b3c7;
    font-weight: 800;
    text-align: right;
    line-height: 1;
  }
  .agenda__slot {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .agenda__divider {
    width: 100%;
    height: 2px;
    background: rgba(255, 255, 255, 0.12);
    margin: auto 0;
  }
  .agenda__cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .agenda__cardbtn {
    text-align: left;
  }
  .agenda__event-simple {
    text-align: center;
    color: #fff;
    font-weight: 800;
  }
  .agenda__event {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #cbd5e1;
    font-weight: 800;
    line-height: 1;
  }
  .agenda__event-line {
    flex: 1;
    height: 2px;
    background: rgba(255, 255, 255, 0.12);
  }
  .agenda__event-label {
    white-space: nowrap;
  }

  .modal__tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .tag {
    padding: 6px 10px;
    background: #25324a;
    border-radius: 10px;
  }
  .modal__text {
    color: #e6edf8;
    line-height: 1.9;
  }
  .speaker__head {
    display: flex;
    gap: 12px;
    align-items: center;
    margin-bottom: 12px;
  }
  .speaker__head .avatar {
    width: 56px;
    height: 56px;
    border-radius: 9999px;
    object-fit: cover;
  }
  .speaker__head .name {
    color: #fff;
    font-weight: 900;
  }
  .speaker__head .title {
    color: #a9b3c7;
  }

  .hidden {
    display: none !important;
  }

  @media (max-width: 840px) {
    .agenda__row {
      grid-template-columns: 64px 1fr;
    }
    .agenda__cards {
      grid-template-columns: 1fr;
    }
  }
</style>
