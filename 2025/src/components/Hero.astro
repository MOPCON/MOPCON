---
import "../styles/global.css";
import clouds from "../assets/hero/clouds.svg";
import ellipse from "../assets/hero/Hero.png";
import title from "../assets/hero/title.png";
import star from "../assets/hero/star.svg";
import Typewriter from "../components/hero/Typewriter.astro";
import { Image } from 'astro:assets';


const typeWriteMsg = ["Warning: Our hardware thinks."];
---

<div class="bg-[#020618] min-h-screen flex flex-col relative overflow-x-hidden">
	<div class="absolute inset-0 z-[1] overflow-hidden">
		<Image src={clouds} alt="Clouds" class="absolute top-0 max-sm:top-[50px] w-full h-auto object-contain" />
		<Image 
			src={ellipse} 
			alt="Ellipse" 
			class="absolute w-full h-auto object-contain max-sm:top-1/3 max-sm:left-1/2 max-sm:-translate-x-1/2 max-sm:scale-150 sm:max-lg:top-1/3 sm:max-lg:left-0 sm:max-lg:translate-x-0 lg:top-1/4 lg:left-0" 
		/>
	</div>

	<div class="relative z-40 flex flex-col min-h-screen px-6 sm:px-10 pt-24 pb-6 md:pt-[6.25rem]">
		
		<div class="w-full mb-auto">
			<div class="mb-8 sm:mb-0">
				<Image src={title} alt="Title" class="w-[250px] sm:w-[300px]" />
				<div class='flex mt-4 sm:mt-6 items-center gap-2'> 
					<Image src={star} alt="Star" class="h-6 sm:h-7" />
					<p class="text-2xl sm:text-3xl text-white font-bold leading-7">行動科技年會</p>
					<Image src={star} alt="Star" class="h-6 sm:h-7" />
				</div>
			</div>
		</div>

		<div class="flex-1"></div>

		<div class="w-full space-y-4 sm:space-y-3">
			<div class="space-y-2">
				<p class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white">11.08 → 11.09</p>
				<p class="text-2xl sm:text-3xl lg:text-4xl font-bold text-white">@NKUST Nanzih Campus</p>
			</div>

			<div class="flex flex-wrap gap-3">
				<button 
					onclick="window.location.href='/2025/agenda'"
					class="bg-gray-400 text-black text-lg sm:text-xl font-bold py-4 px-6 sm:py-5 sm:px-8 rounded-full hover:bg-white hover:shadow-[0_0_20px_rgba(255,255,255,0.8)] active:bg-gray-300 transition-all duration-200">
					大會議程
				</button>
				<button 
					onclick="window.location.href='#tickets'"
					class="group bg-cyan-400 text-black text-lg sm:text-xl font-bold py-4 px-6 sm:py-5 sm:px-8 rounded-full hover:bg-cyan-300 hover:shadow-[0_0_20px_rgba(34,211,238,0.8)] active:bg-cyan-500 transition-all duration-200">
					立即購票 
					<span class="inline-block transition-transform duration-300 ease-out group-hover:translate-x-1">→</span>
				</button>
			</div>

			<div class="w-full overflow-hidden pt-2 sm:pt-0">
				<div class="relative w-full">
					<p class="font-bold text-white text-2xl sm:text-4xl lg:text-5xl py-4 sm:py-6 opacity-50 font-mantou break-words">
						{typeWriteMsg[0]}
					</p>

					<div class="absolute inset-0 w-full">
						<Typewriter
							words={typeWriteMsg}
							speed={3000}
							deleteSpeed={3000}
							pauseTime={3000}
							className="font-bold text-white text-2xl sm:text-4xl lg:text-5xl py-4 sm:py-6 break-words block"
						/>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
