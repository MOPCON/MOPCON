---
import { Image } from 'astro:assets';
import venueImage from '../assets/venue/venue-image.webp';
import SubtractIcon from '../assets/venue/Subtract.svg';
import MapPinIcon from '../assets/venue/map-pin.svg';
import ExternalLinkIcon from '../assets/venue/external-link.svg';
import TrainIcon from '../assets/venue/train.svg';
import BusIcon from '../assets/venue/bus.svg';
import HSRIcon from '../assets/venue/hsr.svg';
import EllipseMobileImage from '../assets/venue/Ellipse-mobile.png';
import EllipseDesktopImage from '../assets/venue/Ellipse-desktop-2x.png';

const transports = [
  {
    icon: BusIcon,
    title: '公車 Bus',
    desc: '高雄科大(楠梓)：6號公車、29號公車、市公車28、市公車301、7C公車',
  },
  {
    icon: HSRIcon,
    title: '高鐵 HSR',
    desc: '由左營高鐵站搭捷運至後勁站下車，步行100公尺即可到達',
  },
  {
    icon: TrainIcon,
    title: '火車 Train',
    desc: '楠梓火車站 > 6號公車/29號公車 > 高雄科大(楠梓)\n高雄火車站 > 28公車/301號公車 > 後勁國中',
  },
  {
    icon: TrainIcon,
    title: '捷運 MRT',
    desc: '搭乘高雄捷運於後勁站下車，步行100公尺即可到達',
  }
];

const cardItems = [
  {
    tag: '1',
    title: '場前無古人後無來者的盛會',
    description: 'MOPCON 作為全台第一個針對移動式平台的科技年會，我們貫徹始終，堅持在南部耕耘著這片富含歷史文化的土地。從 NFC 的浪潮到如今的 AI 革命，今年讓我們再次一同聚在一起，見證技術如何改變生活、改寫歷史、創造未來！'
  },
    {
    tag: '2',
    title: '天超過十場的精彩議程分享',
    description: 'MOPCON 作為全台第一個針對移動式平台的科技年會，我們貫徹始終，堅持在南部耕耘著這片富含歷史文化的土地。從 NFC 的浪潮到如今的 AI 革命，今年讓我們再次一同聚在一起，見證技術如何改變生活、改寫歷史、創造未來！'
  },
    {
    tag: '3',
    title: '種不能錯過的南部魅力一次擁有',
    description: '做為濁水溪以南最大的科技年會，我們匯聚南部技術社群，帶來最新的技術分享與實戰交流。這裡有熱情好客的南部朋友，等你來結交；有深厚實力的技術專家，等你來切磋；還有令人難以抗拒的南部美食，滿足你味蕾的渴望，讓你從身到心都能滿載而歸。',
  },
  
]

---
<style lang="scss">
  .font-mantou {
    font-family: "Mantou Sans", "Noto Sans TC", sans-serif;
  }

  .venue__section {
      color: #ffffff;

    &__info {
      max-width: 900px;
      margin: 0 auto;
      padding: 48px 24px;

      &-title {
        display: flex;
        gap: 4px;
        padding: 8px 16px;
        border-radius: 40px;
        width: 125px;
      }

      &-link {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 5px;
        padding: 8px 24px;
        width: 227px;
        height: 52px;
        background-color: #cac7c7;
        font-weight: 700;
        cursor: pointer;
        transition: background-color 0.3s ease;

        &:hover {
          background-color: #ffffff;
          box-shadow: 0 0 20px rgba(255, 255, 255, 0.7); // 向外的光暈
          gap: 10px
        }

        &:active {
          background-color: #cac7c7;
          gap: 10px;
        }
      }
    }

    &-reason {
      background-color: #020618;
      position: relative;
      overflow: hidden;    // 超出的隱藏
      white-space: nowrap; // 不換行

      &--text {
        // 漸層
        background: linear-gradient(90deg, #607BDA 0%, #B8C3F0 100%);
        background: -webkit-linear-gradient(90deg, #607BDA 0%, #B8C3F0 100%);
        background-clip: text;
        -webkit-background-clip: text;
        color: transparent;

        // 跑馬燈效果
        display: inline-flex;
        animation: marquee 20s linear infinite;
      }
    }
    // 跑馬燈動畫
    @keyframes marquee {
      0%   { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }

    &__cardlist {

      @media (max-width: 640px) {
        margin-top: 3rem;
      }
      
      // 大螢幕橫向滾動容器
      @media (min-width: 640px) {
        overflow-x: auto;
        overflow-y: hidden;
        scrollbar-width: none; // Firefox 隱藏滾動軸
        -ms-overflow-style: none; // IE 隱藏滾動軸
        cursor: move;
        
        &::-webkit-scrollbar { // WebKit 隱藏滾動軸
          display: none;
        }
      }

      &-container {
        // 中等螢幕：3列網格
        @media (min-width: 640px) and (max-width: 1023px) {
          grid-template-columns: repeat(3, 1fr);
          gap: 1rem;
        }

        // 大螢幕：橫向滾動
        @media (min-width: 1024px) {
          display: flex;
          gap: 1.5rem;
          padding-bottom: 1rem;
        }
      }

      &-card {
        min-width: 342px;
        min-height: 340px;
        background-color: #182434;
        flex-shrink: 0; // 防止在flex容器中被壓縮

        // 不同螢幕時的高度
        @media (min-width: 390px) {
          min-height: 330px;
        }

        @media (min-width: 500px) {
          min-height: 280px;
        }

        // 不同螢幕時的寬度
        @media (min-width: 640px) {
          min-width: 700px;
          min-height: 245px;
          width: 700px;
        }
        @media (min-width: 768px) {
          min-width: 825px;
          height: 245px;
          width: 825px;
        }

        &--title {
          // 漸層
          background: linear-gradient(to right, #607BDA 0%, #B8C3F0 100%);
          background: -webkit-linear-gradient(to right, #607BDA 0%, #B8C3F0 100%);
          background-clip: text;
          -webkit-background-clip: text;
          color: transparent;
        }
      }
    }
  }

</style>

<section class="venue__section">
  <div class="venue__section__info sm:pl-8">
    <!-- 場地資訊 -->
    <div class="venue__section__info-title my-8 bg-grey-400">
      <SubtractIcon />
      <h1 class="font-bold font-spaceGrotesk">會場資訊</h1>
    </div>
    <div class="flex flex-col md:grid md:grid-cols-2 mb-6">
      <Image class="border-8 mb-8 border-grey-400 rounded-3xl" src={venueImage} alt="Venue Image" />
      <div class="md:p-6">
        <h2 class="venue__section__info-location font-mantou text-4xl">高雄科技大學 楠梓校區</h2>
        <div class="venue__section__info-location font-mantou text-2xl">NKUST Nanzi Campus</div>
        <div class="flex gap-1 my-6 text-lg"><MapPinIcon />高雄市楠梓區瑞屏里025鄰海專路142號</div>
        <a href="https://maps.app.goo.gl/CQERfwKxk6JLDK1x6" target="_blank" class="venue__section__info-link mb-3 rounded-3xl text-black">打開Google Map<ExternalLinkIcon /></a>
      </div>
    </div>

    <!-- 交通方式列表 -->
    <div class="my-4">
      <p class="font-bold text-xl">要怎麼去？</p>
    </div>
    <ul class="flex flex-col sm:grid sm:grid-cols-2 sm:gap-x-8 sm:gap-y-4 mt-8">
      {transports.map(({ icon: Icon, title, desc }) => (
        <li class="flex items-center gap-4 mb-8 sm:mb-0">
          <Icon class="w-[72px] h-[72px] flex-shrink-0"/>
          <div class="text-white">
            <h4 class="font-bold text-2xl">{title}</h4>
            <p class="tablet:whitespace-pre-line">{desc}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
  <!-- 紫色背景圖區塊 + 跑馬燈文字 -->
  <div class="relative">
    <picture class="absolute right-0 -top-90 sm:top-8 z-[-1] sm:scale-200 sm:-translate-x-42 md:top-20 md:-translate-x-42 md:scale-x-200 md:scale-y-300 lg:-top-20 lg:scale-350 lg:right-62">
      <!-- 大於等於640px換另一張 -->
      <source srcset={EllipseDesktopImage.src} media="(min-width: 2000px)" />
      <!-- 預設手機用 Ellipse -->
      <Image class="ellipse" src={EllipseMobileImage} alt="Ellipse" />
    </picture>
    <div class="venue__section-reason px-4 py-6 rotate-[-2.15deg] translate-y-8 sm:py-8 md:py-15 sm:translate-y-20 md:translate-y-24 lg:translate-y-32">
      <div class="venue__section-reason--text font-mantou font-normal text-2xl gap-56 sm:text-4xl sm:gap-128 md:text-7xl">
        <span>三大不能錯過 MOPCON 2025 的理由</span>
        <span>三大不能錯過 MOPCON 2025 的理由</span>
      </div>
    </div>
  </div>

  <!-- 卡片 -->
  <div class="venue__section__cardlist mt-22 px-6 sm:mt-36 lg:mt-56 z-10">
    <div class="venue__section__cardlist-container sm:grid sm:grid-cols-3 sm:gap-4 lg:pl-8">
      { cardItems.map(({ tag, title, description }) => (
        <div class="venue__section__cardlist-card border-grey-400 border-8 bg- rounded-3xl p-6 mb-6 last:mb-0">
          <div class="font-mantou flex items-center gap-4 pl-2 mb-4 sm:items-baseline">
            <div class="text-[54px]">{tag}</div>
            <div class="venue__section__cardlist-card--title text-[32px] leading-9">{title}</div>
          </div>
          <p class="font-bold pb-1.5">{description}</p>
        </div>
      ))}
    </div>
  </div>

</section> 