---
// No props needed for this static component
---

<div
  class="min-h-screen bg-gradient-to-b from-[#314158] to-[#0c1425] text-white relative overflow-hidden"
  style="border-radius: 120px;"
>
  <!-- Main Container -->
  <div
    class="container mx-auto px-4 py-8 md:py-16 flex flex-col items-center text-center relative z-10"
  >
    <!-- MOPCON Title -->
    <div class="mb-8">
      <img
        src="/src/assets/mopcon-title.svg"
        alt="MOPCON"
        class="mx-auto"
        style="filter: brightness(0) invert(1); height: 3.25rem;"
      />
    </div>

    <!-- Chinese Subtitle -->
    <h1
      class="font-bold mb-6 bg-gradient-to-r from-[#607BDA] to-[#B8C3F0] bg-clip-text text-transparent"
      style="font-family: 'MantouSans', sans-serif; font-size: 4.5rem;"
    >
      南台灣最大行動科技年會
    </h1>

    <!-- Tagline -->
    <p class="text-xl md:text-2xl mb-12 opacity-90">
      聚集知識與人才 ✕ 南台灣最大行動科技年會 ✕ 放大科技創新力
    </p>

    <!-- Main Image -->
    <div class="w-full max-w-4xl mx-auto mb-16 relative">
      <div class="rounded-2xl overflow-hidden shadow-2xl border-4 border-white relative">
        <img
          src="/src/assets/mopcon.jpg"
          alt="MOPCON 2024 團體照"
          class="w-full h-auto"
        />
        <!-- Gradient overlay at bottom -->
        <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-[#5755A4] to-transparent"></div>
      </div>
    </div>

    <!-- Statistics Section -->
    <div
      class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-16 mb-16 w-full max-w-4xl"
    >
      <div class="flex flex-col items-center">
        <div class="text-sm md:text-base text-gray-200 mb-2">持續舉辦</div>
        <div class="text-4xl md:text-6xl lg:text-7xl font-bold mb-2" style="font-family: 'MantouSans', sans-serif;">13</div>
        <div class="text-lg md:text-xl text-gray-200">年</div>
      </div>
      <div class="flex flex-col items-center">
        <div class="text-sm md:text-base text-gray-200 mb-2">精彩議程</div>
        <div class="text-4xl md:text-6xl lg:text-7xl font-bold mb-2" style="font-family: 'MantouSans', sans-serif;">30+</div>
        <div class="text-lg md:text-xl text-gray-200">場</div>
      </div>
      <div class="flex flex-col items-center">
        <div class="text-sm md:text-base text-gray-200 mb-2">熱情會眾</div>
        <div class="text-4xl md:text-6xl lg:text-7xl font-bold mb-2" style="font-family: 'MantouSans', sans-serif;">1000+</div>
        <div class="text-lg md:text-xl text-gray-200">人</div>
      </div>
    </div>

    <!-- Description Text -->
    <div class="max-w-4xl mx-auto mb-16 text-left space-y-6">
      <p class="text-base md:text-xl leading-relaxed opacity-90">
        MOPCON 為高雄「行動」的英文開頭自主的活動，今年進入第 14 年！從 2012 年開始，每年吸引眾多參加人數持續增長，從 160 人的小型聚會，逐漸成為 1000 人以上的科技盛宴！
      </p>
      <p class="text-base md:text-xl leading-relaxed opacity-90">
        透過每年舉辦的交流盛會，持續匯集知識、人才與資源，打造高雄資訊交流圈，促使進人才流動與產業發展，帶動南台灣高雄經濟產業發展。相信每個參與者都能透過這個知識與資源帶回自己公司、團隊，讓這份能力產生更大的影響力。
      </p>
    </div>

    <!-- Social Media Section -->
    <div class="mt-16 pt-8 border-t border-gray-400 w-full max-w-4xl">
      <div class="text-center mb-6">
        <p class="text-lg text-gray-200">在這裡找到 #MOPCON</p>
      </div>
      <div class="flex justify-center items-center gap-4">
        <!-- Facebook -->
        <a href="#" class="w-12 h-12 rounded-lg bg-[#1877F2] flex items-center justify-center hover:opacity-80 transition-opacity">
          <img src="/src/assets/facebook.svg" alt="Facebook" class="w-6 h-6" />
        </a>

        <!-- Threads -->
        <a href="#" class="w-12 h-12 rounded-lg bg-black border-2 border-gray-400 flex items-center justify-center hover:opacity-80 transition-opacity">
          <img src="/src/assets/threads.svg" alt="Threads" class="w-6 h-6" />
        </a>

        <!-- X (Twitter) -->
        <a href="#" class="w-12 h-12 rounded-lg bg-black border-2 border-gray-400 flex items-center justify-center hover:opacity-80 transition-opacity">
          <img src="/src/assets/x.svg" alt="X" class="w-6 h-6" />
        </a>

        <!-- Telegram -->
        <a href="#" class="w-12 h-12 rounded-lg bg-[#0088CC] flex items-center justify-center hover:opacity-80 transition-opacity">
          <img src="/src/assets/telegram.svg" alt="Telegram" class="w-6 h-6" />
        </a>

        <!-- Instagram -->
        <a href="#" class="w-12 h-12 rounded-lg bg-gradient-to-br from-[#FFD600] via-[#FF0100] to-[#D800B9] flex items-center justify-center hover:opacity-80 transition-opacity">
          <img src="/src/assets/instagram.svg" alt="Instagram" class="w-6 h-6" />
        </a>
      </div>
    </div>
  </div>
</div>
