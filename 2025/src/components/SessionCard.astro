---
import { Image } from 'astro:assets';
import { MapPin } from 'lucide-astro';

interface Speaker {
  name: string;
  title: string;
  avatar?: any;
}

interface Session {
  room: string; // R1, R2
  title: string;
  topics: string[];
  speaker: Speaker | Speaker[]; // Support both single speaker and multiple speakers
}

const topics = {
  "od-ai": "On-Device AI Technologies",
  "edge-ai": "Mobile & Edge AI Hardware Platforms",
  "performance-resource": "Performance & Resource Optimization",
  "privacy-ai": "Privacy-Preserving AI",
  "real-world-ai": "Real-world AI Applications",
  "product-design": "Product Design & Operations",
};

const { session } = Astro.props as { session: Session };
---

<article class="card" data-room={session.room}>
  <header class="card__head">
    <span class="card__room"><MapPin size={16} />{session.room}</span>
  </header>

  <h3 class="card__title">{session.title}</h3>

  <div class="card__topics">
    {session.topics.map((t) => (<span class="card__topic">{t}</span>))}
  </div>

  <footer class="card__speaker">
    {Array.isArray(session.speaker) ? (
      // Multiple speakers layout
      <div class="card__speakers-multiple">
        {session.speaker.map((speaker, index) => (
          <div class="card__speaker-item">
            {speaker.avatar && <Image src={speaker.avatar} alt={speaker.name} width={600} height={600} quality={100} />}
            <div class="card__speaker-info">
              <div class="card__speaker-name">{speaker.name}</div>
              <div class="card__speaker-title">{speaker.title}</div>
            </div>
          </div>
        ))}
      </div>
    ) : (
      // Single speaker layout
      <>
        {session.speaker.avatar && <Image src={session.speaker.avatar} alt={session.speaker.name} width={600} height={600} quality={90} />}
        <div class="card__speaker-info">
          <div class="card__speaker-name">{session.speaker.name}</div>
          <div class="card__speaker-title">{session.speaker.title}</div>
        </div>
      </>
    )}
  </footer>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: #0b1222;
    border-radius: 16px;
    padding: 24px;
    box-shadow: 0 0 0 2px rgba(149, 164, 255, 0.3) inset;
    position: relative;
    height: 100%;
  }

  .card[data-room="R1"]::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 16px;
    padding: 4px;
    background: linear-gradient(180deg, #607BDA 0%, #B8C3F0 100%);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  .card[data-room="R1"] {
    box-shadow: none;
  }

  .card[data-room="R2"]::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 16px;
    padding: 4px;
    background: linear-gradient(180deg, #25D3FF 0%, #92E9FF 100%);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  .card[data-room="R2"] {
    box-shadow: none;
  }

  .card[data-room="R1 & R2"]::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 16px;
    padding: 4px;
    background: linear-gradient(180deg, #607BDA 0%, #B8C3F0 50%, #25D3FF 100%);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  .card[data-room="R1 & R2"] {
    box-shadow: none;
  }
  .card__head { display:flex; align-items:center; gap:6px; color:#cbd5e1; }
  .card__room { border-radius: 9999px; padding: 4px 12px; background: #1f2a44; font-weight: 800; font-size: 1rem; display: flex; align-items: center; gap: 6px; }
  .card__title { color: #fff; font-weight: 800; font-size: 18px; line-height: 1.4; }
  .card__topics { display: flex; flex-wrap: wrap; gap: 8px; }
  .card__topic { padding: 6px 10px; background: #0d172a; color: #c1c8d6; border-radius: 10px; font-size: 12px; box-shadow: inset 0 0 0 1px rgba(255,255,255,.06); }
  .card__speaker { display:flex; align-items:center; gap:10px; margin-top:auto; }
  .card__speaker img { width: 60px; height: 60px; border-radius: 9999px; object-fit: cover; image-rendering: -webkit-optimize-contrast; }
  .card__speaker-name { color:#fff; font-weight: 800; }
  .card__speaker-title { color:#a9b3c7; font-size: 13px; }
  
  /* Multiple speakers layout */
  .card__speakers-multiple {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
  }
  
  .card__speaker-item {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  
  .card__speaker-item img {
    width: 50px;
    height: 50px;
    border-radius: 9999px;
    object-fit: cover;
    image-rendering: -webkit-optimize-contrast;
  }
  
  .card__speaker-item .card__speaker-name {
    font-size: 14px;
  }
  
  .card__speaker-item .card__speaker-title {
    font-size: 12px;
  }
</style>



