---
import { Image } from 'astro:assets';
import heroBg from '../assets/hero-bg.jpg';
import TSMClogo from '../assets/sponsor/1-4logo1_1.webp';
import Dcardlogo from '../assets/sponsor/dcard_logo.webp';
import Titanlogo from '../assets/sponsor/Titansoft_LOGO_03.webp';
import archilifeLogo from '../assets/sponsor/archilife.png';
import hexSchoolLogo from '../assets/sponsor/hexschool_logo.webp';
import nchcLogo from '../assets/sponsor/2025_NCHC_Logo.webp';
import SponsorModal from './SponsorModal.astro';

// Company data
const companies = [
    {
        id: 'tsmc',
        name: '台灣積體電路製造股份有限公司',
        description: '台積公司是世界領先的專業積體電路製造服務公司，背後關鍵秘訣是：Fab runs on code──跑在程式碼上的晶圓廠。台積 IT 是半導體前瞻製程的重要支援夥伴，產品藍圖涵蓋資通訊建構、AI 應用、技術系統及企業系統，服務的使用者來自工廠、企業員工及合作夥伴。我們匯聚全球頂尖人才，導入矽谷最新 Tech Stack 打造雲原生和數位轉型。Change is happening. Join us now!',
        siteUrl: 'https://www.tsmc.com/chinese',
        logo: TSMClogo.src
    },
    {
        id: 'dcard',
        name: '狄卡科技股份有限公司 Dcard',
        description: '',
        siteUrl: '',
        logo: Dcardlogo.src
    },
    {
        id: 'titansoft',
        name: '新加坡商鈦坦科技',
        description: '',
        siteUrl: 'https://gotica.io/Website/MC2025',
        logo: Titanlogo.src
    },
    {
        id: 'archilife',
        name: '祐生研究基金會',
        description: '',
        siteUrl: '',
        logo: archilifeLogo.src
    },
    {
        id: 'nchc',
        name: '國家高速網路與計算中心',
        description: '財團法人國家實驗研究院（NIAR，簡稱國研院）成立於2003年6月，隸屬國家科學及技術委員會，下轄7個國家級實驗研究中心。國研院以「追求全球頂尖、開創在地價值」為願景，秉持「建構研發平台、支援學術研究、推動前瞻科技、培育科技人才」四大任務，整合核心技術與設施，為產官學研界提供地球環境、資通訊科技、生醫科技及科技政策等領域之研發平台與技術服務，轉譯學術研究成果，創造新興產業，貢獻民生福祉。​而『國家高速網路與計算中心』（NCHC，簡稱國網中心）成立於1991年，為國研院轄下中心，擁有全台唯一共用大型計算平台和學研網路設施。國網中心以「驅動轉型，為更美好的未來而努力」為信念，提供世界級高速計算與學研網路設施，服務學術、研究、產業和政府機構。面對人工智慧、大數據、數位孿生等應用需求，國網中心持續建立新一代高速運算平台、強韌學研網路，並進行資安、量子計算與巨量資料分析等前瞻科技研發，積極參與國際合作交流。',
        siteUrl: 'https://www.nchc.org.tw',
        logo: nchcLogo.src
    },
    {
        id: 'hexschool',
        name: '六角學院',
        description: '',
        siteUrl: '',
        logo: hexSchoolLogo.src
    }
];
---

<section
class="relative w-full flex flex-col items-center overflow-visible px-[240px] py-[120px] tablet:px-[30px] desktop:px-[400px]"
>
<Image src={heroBg} alt="Hero Background" class="absolute top-0 left-0 w-full h-[87px] tablet:h-[230px] desktop:h-[323px] object-cover" />

<div
    class="relative z-10 w-full flex flex-col items-center gap-10 text-white"
>
    <h2
        class="font-mantou text-center text-[44px] tablet:text-[54px] leading-tight w-full px-0"
    >
        <div class="text-center">
            <!-- mobile 版本 (小螢幕強制兩行) -->
            <span class="block tablet:hidden">
                感謝<br />
                <span
                    class="bg-main-gradient bg-clip-text text-transparent"
                >
                所有支持 MOPCON 的贊助商
                </span>
            </span>

            <!-- >=390px 版本 (單行) -->
            <span class="hidden tablet:inline"
                >感謝<span
                    class="bg-main-gradient bg-clip-text text-transparent"
                    >所有支持 MOPCON 的贊助商</span
                ></span
            >
        </div>
    </h2>

    <div class="flex w-full flex-col gap-6 text-left">
        <p class="font-noto text-[20px] font-bold leading-8">
          MOPCON 目前已是南台灣最大技術社群研討會，成立宗旨為連結產業與資訊工程技術，以培養更多資訊科技人才，推動高雄產業創新發展，而沒有夥伴們的支持，這個願景就不可能成真！謝謝這 10+ 年來每一位夥伴的加入，和我們一起凝聚南臺灣的人才和知識，共同成長、學習！
        </p>
    </div>

    <span
        class="bg-main-gradient bg-clip-text text-transparent font-mantou text-center text-[44px]"
        >書院之階</span
    ></span
>
    <div class="w-full flex justify-center items-stretch gap-6">
      <div class="featured-talk-card" data-sponsor-card data-company-id="tsmc">
        <h3 class="text-3xl font-bold mb-4 text-center" style="color: var(--title-purple);">
          台灣積體電路製造股份有限公司
        </h3>
        <div class="image-container">
          <Image src={TSMClogo} alt="TSMC Logo" class="w-52 object-contain" />
        </div>
      </div>
    </div>

    <span
    class="bg-main-gradient bg-clip-text text-transparent font-mantou text-center text-[44px]"
    >府城微光</span
></span
>
<div class="w-full flex justify-center items-stretch gap-6">
  <div class="featured-talk-card" data-sponsor-card data-company-id="dcard">
    <h3 class="text-3xl font-bold mb-4 text-center" style="color: var(--title-purple);">
      狄卡科技股份有限公司 Dcard
    </h3>
    <div class="image-container">
      <Image src={Dcardlogo} alt="Dcard Logo" class="w-60 object-contain" />
    </div>
  </div>
</div>

<span
class="bg-main-gradient bg-clip-text text-transparent font-mantou text-center text-[44px]"
>巷弄之聲</span
></span
>
<div class="w-full flex flex-col md:flex-row justify-center items-stretch gap-6">
<div class="featured-talk-card" data-sponsor-card data-company-id="titansoft">
<h3 class="text-3xl font-bold mb-4 text-center" style="color: var(--title-purple);">
  新加坡商鈦坦科技
</h3>
<div class="image-container">
  <Image src={Titanlogo} alt="Titansoft Logo" class="w-60 object-contain" />
</div>
</div>
<div class="featured-talk-card" data-sponsor-card data-company-id="archilife">
  <h3 class="text-3xl font-bold mb-4 text-center" style="color: var(--title-purple);">
    祐生研究基金會
  </h3>
  <div class="image-container">
    <Image src={archilifeLogo} alt="Archilife Logo" class="w-60 object-contain" />
  </div>
  </div>
</div>

<span
class="bg-main-gradient bg-clip-text text-transparent font-mantou text-center text-[44px]"
>教育贊助及合作夥伴</span
></span
>
<div class="w-full flex flex-col md:flex-row justify-center items-stretch gap-6">
<div class="featured-talk-card" data-sponsor-card data-company-id="nchc">
<h3 class="text-3xl font-bold mb-4 text-center" style="color: var(--title-purple);">
  國家高速網路與計算中心
</h3>
<div class="image-container">
  <Image src={nchcLogo} alt="NCHC Logo" class="w-[600px] object-contain" />
</div>
</div>
<div class="featured-talk-card" data-sponsor-card data-company-id="hexschool">
  <h3 class="text-3xl font-bold mb-4 text-center" style="color: var(--title-purple);">
    六角學院
  </h3>
  <div class="image-container">
    <Image src={hexSchoolLogo} alt="Hex School Logo" class="w-60 object-contain" />
  </div>
  </div>
</div>
</div>
</section>

<SponsorModal />

<script define:vars={{ companies }}>
    document.addEventListener('DOMContentLoaded', () => {
        const modal = document.querySelector('.sponsor-modal');
        if (!modal) return;

        const companiesMap = new Map(companies.map(c => [c.id, c]));

        function openModal() {
            modal.showModal();
            modal.offsetHeight; // Force reflow
            modal.classList.add('show');
        }

        function closeModal() {
            modal.classList.remove('show');
            setTimeout(() => {
                modal.close();
            }, 300);
        }

        function updateModalContent(company) {
            const logoContainer = document.getElementById('sponsor-modal-logo-container');
            const logoEl = document.getElementById('sponsor-modal-logo');
            const titleEl = document.getElementById('sponsor-modal-title');
            const descriptionEl = document.getElementById('sponsor-modal-description');
            const actionsEl = document.getElementById('sponsor-modal-actions');
            const siteButtonEl = document.getElementById('sponsor-modal-site-button');

            if (logoContainer && logoEl && company.logo) {
                logoEl.src = company.logo;
                logoContainer.style.display = 'flex';
            } else if (logoContainer) {
                logoContainer.style.display = 'none';
            }

            if (titleEl) {
                titleEl.textContent = company.name;
            }

            if (descriptionEl) {
                if (company.description && company.description.trim()) {
                    descriptionEl.textContent = company.description;
                    descriptionEl.style.display = 'block';
                } else {
                    descriptionEl.style.display = 'none';
                }
            }

            if (actionsEl && siteButtonEl) {
                if (company.siteUrl && company.siteUrl.trim()) {
                    siteButtonEl.href = company.siteUrl;
                    actionsEl.style.display = 'flex';
                } else {
                    actionsEl.style.display = 'none';
                }
            }
        }

        // Handle card clicks
        document.addEventListener('click', (e) => {
            const target = e.target;
            const card = target.closest('[data-sponsor-card]');
            
            if (card) {
                const companyId = card.getAttribute('data-company-id');
                if (companyId) {
                    const company = companiesMap.get(companyId);
                    if (company && (company.siteUrl || company.description)) {
                        updateModalContent(company);
                        openModal();
                    }
                }
                return;
            }

            // Handle modal close button clicks
            const closeBtn = target.closest('.sponsor-modal__close') || target.closest('.sponsor-modal__close-button');
            if (closeBtn && modal) {
                closeModal();
                return;
            }
        });

        // Handle backdrop clicks
        modal.addEventListener('click', (e) => {
            if (e.target === modal) {
                closeModal();
            }
        });

        modal.addEventListener('close', () => {
            modal.classList.remove('show');
        });

        modal.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                closeModal();
            }
        });
    });
</script>

<style>
    .featured-talk-card {
    position: relative;
    background: linear-gradient(
      225deg,
      #fbfbfd,
      #c8d4da,
      #ffffff,
      #aec0ce,
      #e3e9ee,
      #fafbfc,
      #d6dfe6,
      #b8c9d3
    );
    border-radius: 1rem;
    padding: 1.5rem;
    box-shadow:
      0 4px 6px -1px rgba(0, 0, 0, 0.1),
      0 2px 4px -1px rgba(0, 0, 0, 0.06);
    transition:
      transform 0.2s ease-in-out,
      box-shadow 0.2s ease-in-out;
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    cursor: pointer;
  }

  .featured-talk-card h3 {
    /* Reserve consistent space for headings so the star rows align */
    min-height: 3rem;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    line-height: 1.2;
  }

  @media (max-width: 767px) {
    .featured-talk-card h3 {
      min-height: 3.5rem;
    }
  }

  .featured-talk-card .star-icon {
    height: 4rem;
    display: flex;
    align-items: center;
  }

  .featured-talk-card p {
    flex: 1;
  }

  .featured-talk-card .image-container {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .featured-talk-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      45deg,
      #e8f0f7,
      #d1e2ec,
      #f5f7f9,
      #c4d6e0,
      #dde6eb,
      #f2f4f6,
      #cad8e1,
      #a8bbca
    );
    border-radius: inherit;
    opacity: 0;
    transition: opacity 0.4s ease-in-out;
    z-index: 1;
  }

  .featured-talk-card:hover {
    transform: translateY(-2px);
    box-shadow:
      0 10px 15px -3px rgba(0, 0, 0, 0.1),
      0 4px 6px -2px rgba(0, 0, 0, 0.05);
  }

  .featured-talk-card:hover::before {
    opacity: 1;
  }

  .featured-talk-card > * {
    position: relative;
    z-index: 2;
  }
</style>