---
// Featured Talks Section Component
import StarIcon from '../assets/star.svg?raw';
---

<section class="relative overflow-hidden bg-[var(--bg-dark)] px-8 py-16">
  <div class="mx-auto max-w-4xl">
    <div class="flex items-center gap-3 mb-6">
      <div>
        <span
          class="inline-flex items-center rounded-full bg-[#314158] px-3 py-1 text-xl text-white"
        >
          <span class="mr-2 w-5 h-5" set:html={StarIcon}></span>
          專題演講
        </span>
      </div>

      <p class="text-white/90 text-xl">
        45 分鐘 <span class="text-gray-200">(含問題及 Q&A)，並需要符合以下主題：</span>
      </p>
    </div>
    <div class="grid gap-6 grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
      <!-- Card 1: On-Device AI Technologies -->
      <div class="featured-talk-card">
        <h3 class="text-xl font-bold mb-4" style="color: var(--title-purple);">
          On-Device AI Technologies
        </h3>
        <div class="star-icon">
          <span class="w-12 h-12 text-black" set:html={StarIcon}></span>
        </div>
        <p class="text-gray-700 leading-relaxed">
          探討各地端設備 (如手機、手錶、IoT 設備) 上執行 AI
          應用的相關技術，包括本地大型語言模型 (Local
          LLM)、邊緣AI框架、神經網絡硬體優化 (NPU)、優化型輕量級模型等，類似
          Apple Intelligence 的實作方式。
        </p>
      </div>

      <!-- Card 2: Mobile & Edge AI Hardware Platforms -->
      <div class="featured-talk-card">
        <h3 class="text-xl font-bold mb-4" style="color: var(--title-purple);">
          Mobile & Edge AI Hardware Platforms
        </h3>
        <div class="star-icon">
          <span class="w-12 h-12 text-black" set:html={StarIcon}></span>
        </div>
        <p class="text-gray-700 leading-relaxed">
          涵蓋支援 AI 的硬體平台，如 Android、iOS、VR/AR 裝置、MCU、嵌入式系統
          (如 Raspberry
          Pi、Arduino、ESP32)、機器人、無人機/無人載具等，涵蓋硬體整合與效能優化的技術。
        </p>
      </div>

      <!-- Card 3: Performance & Resource Optimization -->
      <div class="featured-talk-card">
        <h3 class="text-xl font-bold mb-4" style="color: var(--title-purple);">
          Performance & Resource Optimization
        </h3>
        <div class="star-icon">
          <span class="w-12 h-12 text-black" set:html={StarIcon}></span>
        </div>
        <p class="text-gray-700 leading-relaxed">
          聚焦於提升效能與資源優化處理，包括硬體加速技術、功耗與記憶體優化、模型壓縮與量化效能，跨平台部署的
          Edge Cloud 間協調機制。
        </p>
      </div>

      <!-- Card 4: Privacy-Preserving AI -->
      <div class="featured-talk-card">
        <h3 class="text-xl font-bold mb-4" style="color: var(--title-purple);">
          Privacy-Preserving AI
        </h3>
        <div class="star-icon">
          <span class="w-12 h-12 text-black" set:html={StarIcon}></span>
        </div>
        <p class="text-gray-700 leading-relaxed">
          討論本地 AI 如何確保隱私和資料安全，包括聯邦學習、本地推理處理、AI
          隱私保護策略，以及保護用戶資料安全的實務設計。
        </p>
      </div>

      <!-- Card 5: Real-world AI Applications -->
      <div class="featured-talk-card">
        <h3 class="text-xl font-bold mb-4" style="color: var(--title-purple);">
          Real-world AI Applications
        </h3>
        <div class="star-icon">
          <span class="w-12 h-12 text-black" set:html={StarIcon}></span>
        </div>
        <p class="text-gray-700 leading-relaxed">
          實例探討 AI
          在實際應用的應用，涵蓋語言助手、個人化推薦、自然語言處理、生活解題、行為感知應用、生產系統等實務案例。
        </p>
      </div>

      <!-- Card 6: Product Design & Operations -->
      <div class="featured-talk-card">
        <h3 class="text-xl font-bold mb-4" style="color: var(--title-purple);">
          Product Design & Operations
        </h3>
        <div class="star-icon">
          <span class="w-12 h-12 text-black" set:html={StarIcon}></span>
        </div>
        <p class="text-gray-700 leading-relaxed">
          涵蓋 UI/UX
          設計、專案管理、產品生命週期管理、適配市場的設計思維，或其他協助在部份的設計實踐工作。
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .featured-talk-card {
    position: relative;
    background: linear-gradient(
      225deg,
      #fbfbfd,
      #c8d4da,
      #ffffff,
      #aec0ce,
      #e3e9ee,
      #fafbfc,
      #d6dfe6,
      #b8c9d3
    );
    border-radius: 1rem;
    padding: 1.5rem;
    box-shadow:
      0 4px 6px -1px rgba(0, 0, 0, 0.1),
      0 2px 4px -1px rgba(0, 0, 0, 0.06);
    transition:
      transform 0.2s ease-in-out,
      box-shadow 0.2s ease-in-out;
    height: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .featured-talk-card h3 {
    min-height: 3rem;
    display: flex;
    align-items: flex-start;
  }

  .featured-talk-card .star-icon {
    height: 4rem;
    display: flex;
    align-items: center;
  }

  .featured-talk-card p {
    flex: 1;
  }

  .featured-talk-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      45deg,
      #e8f0f7,
      #d1e2ec,
      #f5f7f9,
      #c4d6e0,
      #dde6eb,
      #f2f4f6,
      #cad8e1,
      #a8bbca
    );
    border-radius: inherit;
    opacity: 0;
    transition: opacity 0.4s ease-in-out;
    z-index: 1;
  }

  .featured-talk-card:hover {
    transform: translateY(-2px);
    box-shadow:
      0 10px 15px -3px rgba(0, 0, 0, 0.1),
      0 4px 6px -2px rgba(0, 0, 0, 0.05);
  }

  .featured-talk-card:hover::before {
    opacity: 1;
  }

  .featured-talk-card > * {
    position: relative;
    z-index: 2;
  }
</style>
