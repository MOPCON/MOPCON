---
import { Image } from 'astro:assets';

import mopconLogo from '../assets/mopcon.svg';
import starWhite from '../assets/star_white.svg';

const currentPath = Astro.url.pathname;
const links = [
  { href: '/about', label: '主辦單位' },
  { href: '/2025/agenda', label: '議程介紹' },
  { href: '/sponsor', label: '贊助夥伴' },
  { href: '/time-machine', label: '時光機' },
];
---

<nav class="navbar">
  <div class="navbar__inner">
    <a class="navbar__brand" href="/">
      <Image src={mopconLogo} alt="MOPCON Logo" class="my-auto w-[90%]" />
    </a>
    
    <!-- Desktop menu -->
    <ul class="navbar__menu">
      {links.map(({ href, label }) => {
        const active = currentPath === href;
        return (
          <li>
            <a href={href} class={active ? 'is-active' : ''}>
              {active && (
                <span class="navbar__star">
                  <Image src={starWhite} alt="active" width={16} height={16} />
                </span>
              )}
              {label}
            </a>
          </li>
        );
      })}
    </ul>
    
    <!-- Mobile hamburger button -->
    <button class="navbar__hamburger" id="mobile-menu-toggle" aria-label="Toggle mobile menu">
      <span class="navbar__hamburger-line"></span>
      <span class="navbar__hamburger-line"></span>
      <span class="navbar__hamburger-line"></span>
    </button>
  </div>
  
  <!-- Mobile menu overlay -->
  <div class="navbar__mobile-overlay" id="mobile-menu">
    <button class="navbar__close" id="mobile-menu-close" aria-label="Close mobile menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M18 6L6 18M6 6L18 18" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    
    <ul class="navbar__mobile-menu">
      {links.map(({ href, label }) => {
        const active = currentPath === href;
        return (
          <li class="navbar__mobile-item">
            <a href={href} class={active ? 'is-active' : ''}>
              {label}
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</nav>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    width: 100%;
    margin: 0 auto;
    background: linear-gradient(180deg, rgba(2,6,24,0.5) 0%, rgba(6,12,34,0.5) 100%);
    backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid rgba(96, 123, 218, 0.15);
  }

  .navbar__inner {
    max-width: 1440px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 24px;
    width: 92%;
  }

  .navbar__brand {
    font-family: 'Mantou Sans', system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, "Apple Color Emoji", "Segoe UI Emoji";
    font-weight: 700;
    font-size: 28px;
    line-height: 1;
    letter-spacing: 0.02em;
    color: #FFFFFF;
    text-decoration: none;
  }

  .navbar__menu {
    list-style: none;
    display: flex;
    gap: 10px;
    margin: 0;
    padding: 0;
  }

  .navbar__menu a {
    font-family: var(--font-family-spaceGrotesk, 'Space Grotesk', sans-serif);
    color: #E5E7EB;
    text-decoration: none;
    font-size: 16px;
    transition: color 150ms ease, opacity 150ms ease;
    display: inline-flex;
    align-items: center;
    padding: 12px 20px;
    border-radius: 24px;
    transition: background-color 150ms ease, opacity 150ms ease;
  }

  .navbar__menu a:hover {
    background-color: #ffffff2d;
  }

  .navbar__menu a:active {
    background-color: #ffffff11;
  }

  .navbar__star {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-right: 6px;
  }

  .navbar__menu a:hover {
    color: #FFFFFF;
  }

  .navbar__spacer {
    height: 0;
  }

  @media (max-width: 960px) {
    .navbar__inner {
      padding: 24px 12px;
    }
    .navbar__menu {
      gap: 20px;
    }
  }

  /* Mobile hamburger button */
  .navbar__hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 30px;
    height: 30px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .navbar__hamburger-line {
    width: 20px;
    height: 2px;
    background-color: #FFFFFF;
    margin: 2px 0;
    transition: all 0.3s ease;
  }

  /* Mobile menu overlay */
  .navbar__mobile-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100vw;
    height: 100vh;
    background-color: #0D0D1A;
    z-index: 9999;
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .navbar__mobile-overlay.is-open {
    display: flex;
    opacity: 1;
    visibility: visible;
  }

  .navbar__close {
    position: absolute;
    top: 30px;
    right: 30px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    z-index: 10000;
  }

  .navbar__mobile-menu {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
  }

  .navbar__mobile-item {
    margin: 0;
  }

  .navbar__mobile-menu a {
    font-family: var(--font-family-spaceGrotesk, 'Space Grotesk', sans-serif);
    color: #FFFFFF;
    text-decoration: none;
    font-size: 24px;
    font-weight: 500;
    transition: color 150ms ease, opacity 150ms ease;
    text-align: center;
  }

  .navbar__mobile-menu a:hover {
    color: #E5E7EB;
  }

  .navbar__mobile-menu a.is-active {
    color: #FFFFFF;
    font-weight: 600;
  }

  @media (max-width: 680px) {
    .navbar__menu {
      display: none;
    }
    
    .navbar__hamburger {
      display: flex;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileMenuClose = document.getElementById('mobile-menu-close');
    
    if (mobileMenuToggle && mobileMenu && mobileMenuClose) {
      // Open mobile menu
      mobileMenuToggle.addEventListener('click', function() {
        mobileMenu.classList.add('is-open');
        document.body.style.overflow = 'hidden'; // Prevent background scrolling
      });
      
      // Close mobile menu
      mobileMenuClose.addEventListener('click', function() {
        mobileMenu.classList.remove('is-open');
        document.body.style.overflow = ''; // Restore scrolling
      });
      
      // Close mobile menu when clicking on overlay (outside menu items)
      mobileMenu.addEventListener('click', function(e) {
        if (e.target === mobileMenu) {
          mobileMenu.classList.remove('is-open');
          document.body.style.overflow = '';
        }
      });
      
      // Close mobile menu when clicking on menu items
      const mobileMenuLinks = mobileMenu.querySelectorAll('a');
      mobileMenuLinks.forEach(link => {
        link.addEventListener('click', function() {
          mobileMenu.classList.remove('is-open');
          document.body.style.overflow = '';
        });
      });
    }
  });
</script>