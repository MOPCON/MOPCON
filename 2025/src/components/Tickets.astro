---
import Button from './Button.astro';
---
<section class="tickets" id="tickets">
    <div>
        <h2 class="tickets__title font-mantou">想要參加嗎？</h2>
        <h4 class="tickets__subtitle font-spaceGrotesk">現在就跟我們一起參與這場盛會！</h4>
        <div class="tickets__container">
            {/* Regular tickets */}
            <div class="tickets__section">
                <div class="tickets__cards-grid">
                    <div class="tickets__card tickets__card--regular">
                        <div class="tickets__card-content">
                            <h3 class="tickets__card-title font-mantou">一般票</h3>
                            <p class="tickets__card-price font-spaceGrotesk">NT$ 899</p>
                        </div>
                    </div>
                    <div class="tickets__card tickets__card--group">
                        <div class="tickets__card-content">
                            <h3 class="tickets__card-title font-mantou">團體三人票</h3>
                            <p class="tickets__card-price-discount font-spaceGrotesk">NT$ 899</p>
                            <p class="tickets__card-price-discount-value font-spaceGrotesk">NT$ 849</p>
                        </div>
                    </div>
                    <div class="tickets__card tickets__card--group">
                        <div class="tickets__card-content">
                            <h3 class="tickets__card-title font-mantou">團體五人票</h3>
                            <p class="tickets__card-price-discount font-spaceGrotesk">NT$ 899</p>
                            <p class="tickets__card-price-discount-value font-spaceGrotesk">NT$ 799</p>
                        </div>
                    </div>
                </div>
                <button 
                    onclick="window.open('https://mopcon.kktix.cc/events/mopcon-2025', target='_blank')"
                    class="tickets__button tickets__button--primary">
                    立即購票 
                    <span class="tickets__button-arrow">→</span>
                </button>
            </div>
            
            {/* Student ticket */}
            <div class="tickets__section tickets__section--student">
                <div class="tickets__card tickets__card--student">
                    <div class="tickets__card-content">
                        <h3 class="tickets__card-title font-mantou">學生票</h3>
                        <h4 class="tickets__card-subtitle font-spaceGrotesk">限量 100 個名額！</h4>
                        <p class="tickets__card-price-discount font-spaceGrotesk">NT$ 899</p>
                        <p class="tickets__card-price-discount-value font-spaceGrotesk">NT$ 299</p>
                    </div>
                </div>
                <button 
                    onclick="window.open('https://mopcon.kktix.cc/events/mopcon-2025-student', target='_blank')"
                    class="tickets__button tickets__button--secondary">
                    立即購票 
                    <span class="tickets__button-arrow">→</span>
                </button>
            </div>
        </div>
    </div>
</section>

<style>
    .tickets {
        background-color: #020618;
        padding: 2rem 1rem;
    }
    
    .tickets__title {
        color: #fff;
        font-size: 60px;
        text-align: center;
        margin-bottom: 16px;
    }   
    
    .tickets__subtitle {
        color: #fff;
        font-size: 24px;
        text-align: center;
        margin-bottom: 2rem;
    }
    
    .tickets__container {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        max-width: 1200px;
        margin: 0 auto;
    }
    
    .tickets__section {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        align-items: center;
    }
    
    .tickets__section--student {
        border-top: 2px solid #fff;
        padding-top: 2rem;
    }
    
    .tickets__cards-grid {
        display: flex;
        flex-direction: row;
        gap: 1rem;
        width: 100%;
        max-width: 1000px;
        justify-content: center;
    }
    
    .tickets__card {
        background-color: #fff;
        padding: 1.5rem;
        border-radius: 16px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        min-height: 200px;
        flex: 1;
        min-width: 200px;
    }
    
    .tickets__card--student {
        max-width: 400px;
        width: 100%;
    }
    
    .tickets__card-content {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        width: 100%;
    }
    
    .tickets__card-subtitle {
        color: red;
        font-weight: 700;
        font-size: 1.25rem;
        margin-bottom: 0.5rem;
    }
    
    .tickets__card-title {
        color: #000;
        font-size: 2.5rem;
        margin-bottom: 1rem;
    }
    
    .tickets__card-price-discount {
        font-size: 1rem;
        text-decoration: line-through;
        color: #999;
        margin-bottom: 0.25rem;
    }   
    
    .tickets__card-price-discount-value {
        color: red;
        font-size: 1.5rem;
        font-weight: bold;
    }
    
    .tickets__card-price {
        color: #000;
        font-size: 1.5rem;
        font-weight: bold;
    }
    
    .tickets__button {
        background-color: #22d3ee;
        color: #000;
        font-size: 1.25rem;
        font-weight: bold;
        padding: 1rem 2rem;
        border-radius: 9999px;
        border: none;
        cursor: pointer;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        min-width: 200px;
        justify-content: center;
    }
    
    .tickets__button:hover {
        background-color: #67e8f9;
        box-shadow: 0 0 20px rgba(34, 211, 238, 0.8);
    }
    
    .tickets__button:active {
        background-color: #0891b2;
    }
    
    .tickets__button-arrow {
        transition: transform 0.3s ease-out;
    }
    
    .tickets__button:hover .tickets__button-arrow {
        transform: translateX(4px);
    }
    
    /* Mobile responsive styles */
    @media (max-width: 768px) {
        .tickets {
            padding: 1.5rem 1rem;
        }
        
        .tickets__title {
            font-size: 32px;
        }
        
        .tickets__subtitle {
            font-size: 18px;
        }
        
        .tickets__container {
            gap: 1.5rem;
        }
        
        .tickets__section {
            gap: 1rem;
        }
        
        .tickets__cards-grid {
            flex-direction: column;
            gap: 0.75rem;
        }
        
        .tickets__card {
            padding: 1rem;
            min-height: 150px;
        }
        
        .tickets__card-title {
            font-size: 1.5rem;
        }
        
        .tickets__card-price {
            font-size: 1.25rem;
        }
        
        .tickets__card-price-discount {
            font-size: 0.875rem;
        }
        
        .tickets__card-price-discount-value {
            font-size: 1.25rem;
        }
        
        .tickets__button {
            font-size: 1rem;
            padding: 0.75rem 1.5rem;
            min-width: 150px;
        }
    }
    
    @media (max-width: 480px) {
        .tickets__title {
            font-size: 28px;
        }
        
        .tickets__subtitle {
            font-size: 16px;
        }
        
        .tickets__card {
            min-height: 120px;
        }
        
        .tickets__card-title {
            font-size: 1.25rem;
        }
        
        .tickets__card-price {
            font-size: 1.125rem;
        }
        
        .tickets__card-price-discount-value {
            font-size: 1.125rem;
        }
    }
</style>