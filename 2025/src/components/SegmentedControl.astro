---
export interface Option {
    label: string;
    value: string;
}

const { options, value } = Astro.props as {
    options: Option[];
    value: string;
};
---

<div class="segmented" data-value={value}>
    <div class="segmented__track">
        <div class="segmented__indicator"></div>
        {
            options.map((opt) => (
                <button
                    class={[
                        "segmented__item",
                        value === opt.value ? "is-active" : "",
                    ].join(" ")}
                    data-value={opt.value}
                >
                    {opt.label}
                </button>
            ))
        }
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        document.querySelectorAll(".segmented").forEach((root) => {
            const items = Array.from(
                root.querySelectorAll<HTMLButtonElement>(".segmented__item"),
            );
            const indicator = root.querySelector<HTMLDivElement>(".segmented__indicator");
            const track = root.querySelector<HTMLDivElement>(".segmented__track");

            // Function to update indicator position
            const updateIndicator = (activeBtn: HTMLButtonElement) => {
                if (!indicator || !track) return;
                
                const trackRect = track.getBoundingClientRect();
                const btnRect = activeBtn.getBoundingClientRect();
                
                const left = btnRect.left - trackRect.left;
                const width = btnRect.width;
                
                indicator.style.transform = `translateX(${left}px)`;
                indicator.style.width = `${width}px`;
            };

            // Initialize indicator position
            const activeBtn = items.find(btn => btn.classList.contains("is-active"));
            if (activeBtn) {
                updateIndicator(activeBtn);
            }

            items.forEach((btn) => {
                btn.addEventListener("click", () => {
                    items.forEach((b) => b.classList.remove("is-active"));
                    btn.classList.add("is-active");
                    updateIndicator(btn);
                    root.dispatchEvent(
                        new CustomEvent("change", {
                            detail: btn.dataset.value,
                            bubbles: true,
                        }),
                    );
                });
            });
        });
    });
</script>

<style>
    .segmented {
        display: inline-block;
    }
    .segmented__track {
        position: relative;
        display: inline-flex;
        gap: 4px;
        padding: 0.5rem;
        border-radius: 9999px;
        background: #0b1222;
        box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
    }
    .segmented__indicator {
        position: absolute;
        top: 0.5rem;
        left: 0rem;
        height: calc(100% - 1rem);
        background: #fff;
        border-radius: 9999px;
        box-shadow: 0 6px 18px rgba(255, 255, 255, 0.35);
        transition: 
            transform 300ms cubic-bezier(0.2, 0.8, 0.2, 1),
            width 300ms cubic-bezier(0.2, 0.8, 0.2, 1);
        z-index: 1;
    }
    .segmented__item {
        position: relative;
        padding: 0.9rem 1rem;
        border-radius: 9999px;
        color: #cbd5e1;
        font-weight: 700;
        font-size: 1.2rem;
        line-height: 1;
        white-space: nowrap;
        border: none;
        background: none;
        cursor: pointer;
        font-family: inherit;
        outline: none;
        transition: color 260ms cubic-bezier(0.2, 0.8, 0.2, 1);
        z-index: 2;
    }
    .segmented__item.is-active {
        color: #0b1222;
    }
    .segmented__item:focus-visible {
        outline: 2px solid rgba(255, 255, 255, 0.5);
        outline-offset: 2px;
    }
</style>
