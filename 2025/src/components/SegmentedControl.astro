---
export interface Option {
  label: string;
  value: string;
}

const { options, value } = Astro.props as {
  options: Option[];
  value: string;
};
---

<div class="segmented" data-value={value}>
  <div class="segmented__track">
    <div class="segmented__thumb" />
    {options.map((opt) => (
      <button
        class={['segmented__item', value === opt.value ? 'is-active' : ''].join(' ')}
        data-value={opt.value}
      >
        {opt.label}
      </button>
    ))}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.segmented').forEach((root) => {
      const track = root.querySelector('.segmented__track') as HTMLElement;
      const thumb = root.querySelector('.segmented__thumb') as HTMLElement;
      const items = Array.from(track.querySelectorAll<HTMLButtonElement>('.segmented__item'));

      function moveThumbTo(active: HTMLButtonElement) {
        const { offsetLeft, offsetWidth } = active;
        thumb.style.transform = `translateX(${offsetLeft}px)`;
        thumb.style.width = `${offsetWidth}px`;
      }

      function init() {
        const active = items.find((el) => el.classList.contains('is-active')) || items[0];
        if (!active) return;
        moveThumbTo(active);
      }

      items.forEach((btn) => {
        btn.addEventListener('click', () => {
          items.forEach((b) => b.classList.remove('is-active'));
          btn.classList.add('is-active');
          moveThumbTo(btn);
          root.dispatchEvent(new CustomEvent('change', { detail: btn.dataset.value, bubbles: true }));
        });
      });

      window.addEventListener('resize', () => {
        const active = items.find((el) => el.classList.contains('is-active'));
        if (active) moveThumbTo(active);
      });

      init();
    });
  });
</script>

<style>
  .segmented { display: inline-block; }
  .segmented__track {
    position: relative;
    display: inline-flex;
    gap: 4px;
    padding: 6px;
    border-radius: 9999px;
    background: #0b1222;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.08);
  }
  .segmented__thumb {
    position: absolute;
    top: 6px;
    left: 6px;
    height: calc(100% - 12px);
    width: 0;
    border-radius: 9999px;
    background: #fff;
    box-shadow: 0 6px 18px rgba(255,255,255,0.35);
    transition: transform 260ms cubic-bezier(.2,.8,.2,1), width 260ms cubic-bezier(.2,.8,.2,1);
    z-index: 0;
  }
  .segmented__item {
    position: relative;
    z-index: 1;
    padding: 10px 16px;
    border-radius: 9999px;
    color: #cbd5e1;
    font-weight: 700;
    font-size: 14px;
    line-height: 1;
    white-space: nowrap;
  }
  .segmented__item.is-active { color: #0b1222; }
</style>


