---
export interface Option {
    label: string;
    value: string;
}

const { options, value } = Astro.props as {
    options: Option[];
    value: string;
};
---

<div class="segmented" data-value={value}>
    <div class="segmented__track">
        {
            options.map((opt) => (
                <button
                    class={[
                        "segmented__item",
                        value === opt.value ? "is-active" : "",
                    ].join(" ")}
                    data-value={opt.value}
                >
                    {opt.label}
                </button>
            ))
        }
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        document.querySelectorAll(".segmented").forEach((root) => {
            const items = Array.from(
                root.querySelectorAll<HTMLButtonElement>(".segmented__item"),
            );

            items.forEach((btn) => {
                btn.addEventListener("click", () => {
                    items.forEach((b) => b.classList.remove("is-active"));
                    btn.classList.add("is-active");
                    root.dispatchEvent(
                        new CustomEvent("change", {
                            detail: btn.dataset.value,
                            bubbles: true,
                        }),
                    );
                });
            });
        });
    });
</script>

<style>
    .segmented {
        display: inline-block;
    }
    .segmented__track {
        display: inline-flex;
        gap: 4px;
        padding: 6px;
        border-radius: 9999px;
        background: #0b1222;
        box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
    }
    .segmented__item {
        padding: 10px 16px;
        border-radius: 9999px;
        color: #cbd5e1;
        font-weight: 700;
        font-size: 14px;
        line-height: 1;
        white-space: nowrap;
        border: none;
        background: none;
        cursor: pointer;
        font-family: inherit;
        outline: none;
        transition:
            color 260ms cubic-bezier(0.2, 0.8, 0.2, 1),
            background-color 260ms cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .segmented__item.is-active {
        color: #0b1222;
        background: #fff;
        box-shadow: 0 6px 18px rgba(255, 255, 255, 0.35);
    }
    .segmented__item:focus-visible {
        outline: 2px solid rgba(255, 255, 255, 0.5);
        outline-offset: 2px;
    }
</style>
